    allocationvars: [0, 1]
    from_scene_reference: !<FileTransform> {src: DaVinci_ACES_to_P3D65_PQ4000nits.clf, interpolation: best}

  - !<ColorSpace>
    name: "DaVinci : Dolby: ST 2084 PQ : P3 D65 : 500 nits"
    family: DaVinci/display_referred/Dolby
    equalitygroup: ""
    bitdepth: 32f
    description: "Dolby: ST 2084 PQ : P3 D65 : 500 nits"
    isdata: false
    allocation: uniform
    allocationvars: [0, 1]
    from_scene_reference: !<FileTransform> {src: DaVinci_ACES_to_P3D65_PQ500nits.clf, interpolation: best}

  - !<ColorSpace>
    name: "DaVinci : Rec.1886: 2.4 Gamma : Rec.709"
    family: DaVinci/display_referred/Rec.1886
    equalitygroup: ""
    bitdepth: 32f
    description: "Rec.1886: 2.4 Gamma : Rec.709"
    isdata: false
    allocation: uniform
    allocationvars: [0, 1]
    from_scene_reference: !<FileTransform> {src: DaVinci_ACES_to_Rec709_2_4y.clf, interpolation: best}

  - !<ColorSpace>
    name: "DaVinci : Rec.2020: 2.4 Gamma : Rec.2020"
    family: DaVinci/display_referred/Rec.2020
    equalitygroup: ""
    bitdepth: 32f
    description: "Rec.2020: 2.4 Gamma : Rec.2020"
    isdata: false
    allocation: uniform
    allocationvars: [0, 1]
    from_scene_reference: !<FileTransform> {src: DaVinci_ACES_to_Rec2020_2_4y.clf, interpolation: best}

  - !<ColorSpace>
    name: "DaVinci : Rec.2100 : HLG 1.2 Gamma : Rec.2020 : 1000 nits"
    family: DaVinci/display_referred/Rec.2100
    equalitygroup: ""
    bitdepth: 32f
    description: "Rec.2100 : HLG 1.2 Gamma : Rec.2020 : 1000 nits"
