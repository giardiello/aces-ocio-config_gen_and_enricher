    allocationvars: [0, 1]
    from_scene_reference: !<FileTransform> {src: DaVinci_ACES_to_Rec2020_PQ2000nits.clf, interpolation: best}

  - !<ColorSpace>
    name: "DaVinci : Rec.2100 : ST 2084 PQ : Rec.2020 : 4000 nits"
    family: DaVinci/display_referred/Rec.2100
    equalitygroup: ""
    bitdepth: 32f
    description: "Rec.2100 : ST 2084 PQ : Rec.2020 : 4000 nits"
    isdata: false
