ociom_version: 1.0
search_path: "."

# Merge ACES 1.3 and ACES 2.0 Studio configs.

merge:
  Merge1:
    base: studio-config-v4.0.0_aces-v2.0_ocio-v2.5.ocio
    input: studio-config-v2.2.0_aces-v1.3_ocio-v2.4.ocio
    options:
      input_family_prefix: ""
      base_family_prefix: ""
      input_first: false
      error_on_conflict: false
      default_strategy: PreferBase
      avoid_duplicates: true
      adjust_input_reference_space: false
    overrides:
      name: studio-config_aces-1-and-2-merge
      description: Merge of studio-config-v2.2.0_aces-v1.3_ocio-v2.4 into studio-config-v4.0.0_aces-v2.0_ocio-v2.5.
      search_path: ""
      environment: {}
      active_displays: []
      active_views: []
      inactive_colorspaces: []
